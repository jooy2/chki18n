{
	"name": "chki18n-docs",
	"version": "0.0.1",
	"description": "The documentation site for chki18n, shared by every language the library ships for.",
	"private": true,
	"type": "module",
	"author": "CDGet (https://cdget.com)",
	"license": "MIT",
	"scripts": {
		"changelog": "node scripts/copy-changelog.mjs",
		"check:lang": "node scripts/check-lang.mjs",
		"dev": "npm run changelog && vitepress dev",
		"build": "npm run changelog && npm run check:lang && vitepress build",
		"serve": "npm run build && vitepress serve",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"typecheck": "tsc --project tsconfig.json"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"markdown-it-container": "^4.0.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"vitepress": "^1.6.4",
		"vitepress-i18n": "^1.4.0",
		"vitepress-sidebar": "^1.40.0"
	},
	"dependencies": {
		"vue": "^3.5.44"
	}
}
