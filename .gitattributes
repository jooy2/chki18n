# Line endings are LF in the working tree on every platform, not just in the
# repository. Without this a Windows checkout rewrites every text file to CRLF,
# and the source hygiene test each port carries then reports a `U+000D` on every
# line — the file is fine, the checkout is not.
* text=auto eol=lf

# Nothing here is text.
*.png binary
*.ico binary
